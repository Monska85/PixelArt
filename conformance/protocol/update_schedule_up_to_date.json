    {
      "send": "@PR 37b3ba61 {\"seq\":2,\"cmd\":\"update_install\",\"target\":\"animations\"}"
    },
    {
      "expect": {
        "seq": 2,
        "ok": true
      }
    },
    {
      "run_update": true
    },
    {
      "send": "@PR 7ecbf409 {\"seq\":3,\"cmd\":\"update_check\"}"
    },
    {
      "expect": {
        "seq": 3,
        "ok": true
      }
    },
    {
      "run_update": true
    },
    {
      "send": "@PR f7862428 {\"seq\":4,\"cmd\":\"status\"}"
    },
    {
      "expect": {
