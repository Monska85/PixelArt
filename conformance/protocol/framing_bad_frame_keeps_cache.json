{
  "description": "a bad_frame reply does not replace the remembered reply",
  "files": {
    "animations/dot.json": "{\"format\":\"pixelart/1\",\"name\":\"Dot\",\"canvas\":{\"width\":16,\"height\":16},\"sprites\":{\"dot\":{\"points\":[[7,7,\"#ff0000\"]]}},\"timeline\":[{\"show\":[\"dot\"]}]}"
  },
  "steps": [
    {
      "send": "@PR 072a6d9b {\"seq\":3,\"cmd\":\"delete\",\"kind\":\"animation\",\"id\":\"dot\"}"
    },
    {
      "expect": {
        "seq": 3,
        "ok": true
      }
    },
    {
      "send": "@PR 00000000 {\"seq\":4,\"cmd\":\"info\"}"
    },
    {
      "expect": {
        "ok": false,
        "error": "bad_frame",
        "message": "<any>"
      }
    },
    {
      "send": "@PR 072a6d9b {\"seq\":3,\"cmd\":\"delete\",\"kind\":\"animation\",\"id\":\"dot\"}"
    },
    {
      "expect": {
        "seq": 3,
        "ok": true
      }
    }
  ]
}
