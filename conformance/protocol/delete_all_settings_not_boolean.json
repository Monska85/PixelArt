{
  "description": "delete_all with a settings value that is not true or false is bad_request: no file is removed and the settings stay",
  "files": {
    "animations/dot.json": "{\"format\":\"pixelart/1\",\"name\":\"Dot\",\"canvas\":{\"width\":16,\"height\":16},\"sprites\":{\"dot\":{\"points\":[[7,7,\"#ff0000\"]]}},\"timeline\":[{\"show\":[\"dot\"]}]}",
    "playlists/christmas.json": "{\"format\":\"pixelart-playlist/1\",\"canvas\":{\"width\":16,\"height\":16},\"items\":[{\"animation\":\"dot\"}]}"
  },
  "settings": {
    "brightness": 7,
    "playlist": "christmas"
  },
  "steps": [
    {
      "send": "@PR e7e139ae {\"seq\":1,\"cmd\":\"delete_all\",\"settings\":1}"
    },
    {
      "expect": {
        "seq": 1,
        "ok": false,
        "error": "bad_request",
        "message": "<any>"
      }
    },
    {
      "send": "@PR 57b65ab0 {\"seq\":2,\"cmd\":\"settings_get\"}"
    },
    {
      "expect": {
        "seq": 2,
        "ok": true,
        "settings": {
          "brightness": 7,
          "playlist": "christmas"
        }
      }
    },
    {
      "expect_files": {
        "animations/dot.json": "{\"format\":\"pixelart/1\",\"name\":\"Dot\",\"canvas\":{\"width\":16,\"height\":16},\"sprites\":{\"dot\":{\"points\":[[7,7,\"#ff0000\"]]}},\"timeline\":[{\"show\":[\"dot\"]}]}",
        "playlists/christmas.json": "{\"format\":\"pixelart-playlist/1\",\"canvas\":{\"width\":16,\"height\":16},\"items\":[{\"animation\":\"dot\"}]}"
      }
    }
  ]
}
