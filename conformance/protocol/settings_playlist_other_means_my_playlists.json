{
  "description": "an older client that sets playlist to another playlist chooses My playlists with that one",
  "files": {
    "animations/dot.json": "{\"format\":\"pixelart/1\",\"name\":\"Dot\",\"canvas\":{\"width\":16,\"height\":16},\"sprites\":{\"dot\":{\"points\":[[7,7,\"#ff0000\"]]}},\"timeline\":[{\"show\":[\"dot\"]}]}",
    "playlists/halloween.json": "{\"format\":\"pixelart-playlist/1\",\"canvas\":{\"width\":16,\"height\":16},\"items\":[{\"animation\":\"dot\"}]}",
    "playlists/christmas.json": "{\"format\":\"pixelart-playlist/1\",\"canvas\":{\"width\":16,\"height\":16},\"items\":[{\"animation\":\"dot\"}]}"
  },
  "steps": [
    {
      "send": "@PR 478cb042 {\"seq\":1,\"cmd\":\"settings_set\",\"playlist\":\"christmas\"}"
    },
    {
      "expect": {
        "seq": 1,
        "ok": true,
        "settings": {
          "brightness": 100,
          "playlist": "christmas",
          "play": "playlists",
          "playlists": [
            "christmas"
          ],
          "wifi_power": "auto",
          "update_mode": "automatic",
          "update_firmware": true,
          "update_animations": true,
          "check_hours": 6,
          "install_start": 0,
          "install_end": 0,
          "timezone": "UTC0",
          "time_sync_hours": 6,
          "ntp_server": "pool.ntp.org",
          "animation_source": "https://monska85.github.io/PixelArt/manifest.json",
          "network_login": false,
          "token": "<any>"
        }
      }
    },
    {
      "send": "@PR 57b65ab0 {\"seq\":2,\"cmd\":\"settings_get\"}"
    },
    {
      "expect": {
        "seq": 2,
        "ok": true,
        "settings": {
          "brightness": 100,
          "playlist": "christmas",
          "play": "playlists",
          "playlists": [
            "christmas"
          ],
          "wifi_power": "auto",
          "update_mode": "automatic",
          "update_firmware": true,
          "update_animations": true,
          "check_hours": 6,
          "install_start": 0,
          "install_end": 0,
          "timezone": "UTC0",
          "time_sync_hours": 6,
          "ntp_server": "pool.ntp.org",
          "animation_source": "https://monska85.github.io/PixelArt/manifest.json",
          "network_login": false,
          "token": "<any>"
        }
      }
    }
  ]
}
