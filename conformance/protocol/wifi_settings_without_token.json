{
  "description": "Over WiFi, the settings replies leave the token out, and status works",
  "transport": "wifi",
  "steps": [
    {
      "send": "@PR 2153638d {\"seq\":1,\"cmd\":\"settings_get\"}"
    },
    {
      "expect": {
        "seq": 1,
        "ok": true,
        "settings": {
          "brightness": 100,
          "playlist": "default",
          "wifi_power": "auto",
          "update_mode": "automatic",
          "update_firmware": true,
          "update_animations": true,
          "check_hours": 6,
          "install_start": 0,
          "install_end": 0,
          "timezone": "UTC0",
          "animation_source": "https://monska85.github.io/PixelArt/manifest.json",
          "network_login": false
        }
      }
    },
    {
      "send": "@PR 5a02e759 {\"seq\":2,\"cmd\":\"settings_set\",\"wifi_power\":\"8.5\"}"
    },
    {
      "expect": {
        "seq": 2,
        "ok": true,
        "settings": {
          "brightness": 100,
          "playlist": "default",
          "wifi_power": "8.5",
          "update_mode": "automatic",
          "update_firmware": true,
          "update_animations": true,
          "check_hours": 6,
          "install_start": 0,
          "install_end": 0,
          "timezone": "UTC0",
          "animation_source": "https://monska85.github.io/PixelArt/manifest.json",
          "network_login": false
        }
      }
    },
    {
      "send": "@PR 77eff14c {\"seq\":3,\"cmd\":\"settings_set\",\"token\":\"abcdefghijklmnop\"}"
    },
    {
      "expect": {
        "seq": 3,
        "ok": false,
        "error": "bad_request",
        "message": "<any>"
      }
    },
    {
      "send": "@PR f7862428 {\"seq\":4,\"cmd\":\"status\"}"
    },
    {
      "expect": {
        "seq": 4,
        "ok": true,
        "wifi": {
          "state": "connected",
          "ip": "127.0.0.1",
          "rssi": -50,
          "power": "8.5",
          "power_reduced": false,
          "hostname": "pixelart-sim",
          "ssid": "PixelArt Simulator"
        },
        "time": {
          "known": false
        },
        "update": {
          "state": "idle",
          "progress": 0,
          "last_check": null,
          "last_result": null,
          "last_detail": null,
          "failed_files": 0,
          "firmware": null,
