          "install_end": "<any>",
          "timezone": "<any>",
          "time_sync_hours": "<any>",
          "ntp_server": "<any>",
          "animation_source": "<any>",
          "network_login": "<any>",
          "token": "<any>"
        }
      }
    }
  ]
}
