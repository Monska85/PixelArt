{
  "description": "when the power record cannot be cleared, delete_all with settings answers storage_error before the settings change",
  "settings": {
    "brightness": 7
  },
  "steps": [
    {
      "power_store_fails": true
    },
    {
      "send": "@PR 595a097c {\"seq\":1,\"cmd\":\"delete_all\",\"settings\":true}"
    },
    {
      "expect": {
        "seq": 1,
        "ok": false,
        "error": "storage_error",
        "message": "<any>"
      }
    },
    {
      "power_store_fails": false
    },
    {
      "send": "@PR 57b65ab0 {\"seq\":2,\"cmd\":\"settings_get\"}"
    },
    {
      "expect": {
