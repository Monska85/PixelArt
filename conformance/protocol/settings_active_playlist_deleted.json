{
  "description": "the active playlist can be deleted, and the setting keeps its value",
  "files": {
    "playlists/christmas.json": "{\"format\":\"pixelart-playlist/1\",\"canvas\":{\"width\":16,\"height\":16},\"items\":[{\"animation\":\"dot\"}]}"
  },
  "steps": [
    {
      "send": "@PR 478cb042 {\"seq\":1,\"cmd\":\"settings_set\",\"playlist\":\"christmas\"}"
    },
    {
      "expect": {
        "seq": 1,
        "ok": true,
        "settings": {
          "brightness": 100,
          "playlist": "christmas"
        }
      }
    },
    {
      "send": "@PR 351116a7 {\"seq\":2,\"cmd\":\"delete\",\"kind\":\"playlist\",\"id\":\"christmas\"}"
    },
    {
      "expect": {
        "seq": 2,
        "ok": true
      }
    },
    {
      "send": "@PR ccc5b064 {\"seq\":3,\"cmd\":\"settings_get\"}"
    },
    {
      "expect": {
        "seq": 3,
        "ok": true,
        "settings": {
          "brightness": 100,
          "playlist": "christmas"
        }
      }
    }
  ]
}
