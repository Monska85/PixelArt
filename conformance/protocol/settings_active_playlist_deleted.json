{
  "description": "the active playlist can be deleted, and the setting keeps its value",
  "files": {
    "playlists/christmas.json": "{\"format\":\"pixelart-playlist/1\",\"canvas\":{\"width\":16,\"height\":16},\"items\":[{\"animation\":\"dot\"}]}"
  },
  "steps": [
    {
      "send": "@PR 478cb042 {\"seq\":1,\"cmd\":\"settings_set\",\"playlist\":\"christmas\"}"
    },
    {
      "expect": {
        "seq": 1,
        "ok": true,
        "settings": {
          "brightness": 100,
          "playlist": "christmas",
          "play": "playlists",
          "playlists": [
            "christmas"
          ],
          "schedule": "default",
          "wifi_power": "auto",
          "update_mode": "automatic",
          "update_firmware": true,
          "update_animations": true,
          "check_hours": 6,
          "install_start": 0,
          "install_end": 0,
          "timezone": "UTC0",
          "time_sync_hours": 6,
          "ntp_server": "pool.ntp.org",
          "animation_source": "https://monska85.github.io/PixelArt/manifest.json",
          "network_login": false,
          "token": "<any>"
        }
      }
    },
    {
      "send": "@PR 351116a7 {\"seq\":2,\"cmd\":\"delete\",\"kind\":\"playlist\",\"id\":\"christmas\"}"
    },
    {
      "expect": {
        "seq": 2,
        "ok": true
      }
    },
    {
      "send": "@PR ccc5b064 {\"seq\":3,\"cmd\":\"settings_get\"}"
    },
    {
      "expect": {
        "seq": 3,
        "ok": true,
        "settings": {
          "brightness": 100,
          "playlist": "christmas",
          "play": "playlists",
          "playlists": [
            "christmas"
          ],
          "schedule": "default",
          "wifi_power": "auto",
          "update_mode": "automatic",
          "update_firmware": true,
          "update_animations": true,
          "check_hours": 6,
          "install_start": 0,
          "install_end": 0,
          "timezone": "UTC0",
          "time_sync_hours": 6,
          "ntp_server": "pool.ntp.org",
          "animation_source": "https://monska85.github.io/PixelArt/manifest.json",
          "network_login": false,
          "token": "<any>"
        }
      }
    }
  ]
}
