{
  "description": "Automatic plays the playlists of a server choice in turn, whatever the date",
  "files": {
    "animations/dot.json": "{\"format\":\"pixelart/1\",\"name\":\"Dot\",\"canvas\":{\"width\":16,\"height\":16},\"sprites\":{\"dot\":{\"points\":[[7,7,\"#ff0000\"]]}},\"timeline\":[{\"show\":[\"dot\"]}]}",
    "playlists/default.json": "{\"format\":\"pixelart-playlist/1\",\"canvas\":{\"width\":16,\"height\":16},\"items\":[{\"animation\":\"dot\"}]}",
    "playlists/halloween.json": "{\"format\":\"pixelart-playlist/1\",\"canvas\":{\"width\":16,\"height\":16},\"items\":[{\"animation\":\"dot\"}]}",
    "playlists/christmas.json": "{\"format\":\"pixelart-playlist/1\",\"canvas\":{\"width\":16,\"height\":16},\"items\":[{\"animation\":\"dot\"}]}",
    "schedules/seasons.json": "{\"format\":\"pixelart-schedule/1\",\"name\":\"Seasons\",\"fallback\":[\"default\"],\"entries\":[{\"name\":\"Halloween\",\"from\":{\"month\":10,\"day\":1},\"to\":{\"month\":11,\"day\":2},\"playlists\":[\"halloween\"]},{\"name\":\"Christmas\",\"from\":{\"month\":12,\"day\":1},\"to\":{\"month\":1,\"day\":6},\"playlists\":[\"christmas\"]}]}",
    "schedules/default.json": "{\"format\":\"pixelart-schedule/1\",\"name\":\"Seasons\",\"fallback\":[\"default\"],\"entries\":[{\"name\":\"Halloween\",\"from\":{\"month\":10,\"day\":1},\"to\":{\"month\":11,\"day\":2},\"playlists\":[\"halloween\"]},{\"name\":\"Christmas\",\"from\":{\"month\":12,\"day\":1},\"to\":{\"month\":1,\"day\":6},\"playlists\":[\"christmas\"]}]}"
  },
  "update_source": {
    "local_date": "2026-10-31"
  },
  "steps": [
    {
      "send": "@PR cc5c2559 {\"seq\":1,\"cmd\":\"server_choice_set\",\"choice\":{\"playlists\":[\"christmas\",\"halloween\"]}}"
    },
    {
      "expect": {
        "seq": 1,
        "ok": true,
        "choice": {
          "playlists": [
            "christmas",
            "halloween"
          ]
        }
      }
    },
    {
      "send": "@PR 50b29320 {\"seq\":2,\"cmd\":\"status\"}"
    },
    {
      "expect": {
        "seq": 2,
        "ok": true,
        "wifi": {
          "state": "connected",
          "ip": "127.0.0.1",
          "rssi": -50,
          "power": "19.5",
          "power_reduced": false,
          "hostname": "pixelart-sim",
          "ssid": "PixelArt Simulator"
        },
        "time": {
          "known": true
        },
        "play": {
          "mode": "auto",
          "source": "server",
          "schedule": null,
          "reason": "playlists",
          "entry": null,
          "playlists": [
            "christmas",
            "halloween"
          ],
          "playing": "christmas",
          "server_choice": {
            "playlists": [
              "christmas",
              "halloween"
            ]
          }
        },
        "update": {
          "state": "idle",
          "progress": 0,
          "last_check": null,
          "last_result": null,
          "last_detail": null,
          "failed_files": 0,
          "firmware": null,
          "files": 0,
          "last_install": null
        }
      }
    }
  ]
}
