{
  "description": "server_choice_set stores a list of playlists that need not be stored, and a new choice replaces it",
  "steps": [
    {
      "send": "@PR cc5c2559 {\"seq\":1,\"cmd\":\"server_choice_set\",\"choice\":{\"playlists\":[\"christmas\",\"halloween\"]}}"
    },
    {
      "expect": {
        "seq": 1,
        "ok": true,
        "choice": {
          "playlists": [
            "christmas",
            "halloween"
          ]
        }
      }
    },
    {
      "send": "@PR 5582dc66 {\"seq\":2,\"cmd\":\"server_choice_set\",\"choice\":{\"playlists\":[\"default\"]}}"
    },
    {
