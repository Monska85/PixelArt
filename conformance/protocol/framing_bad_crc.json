{
  "description": "a CRC that does not match the JSON gets bad_frame without seq and runs nothing",
  "files": {
    "animations/dot.json": "{\"format\":\"pixelart/1\",\"name\":\"Dot\",\"canvas\":{\"width\":16,\"height\":16},\"sprites\":{\"dot\":{\"points\":[[7,7,\"#ff0000\"]]}},\"timeline\":[{\"show\":[\"dot\"]}]}"
  },
  "steps": [
    {
      "send": "@PR 3c250229 {\"seq\":1,\"cmd\":\"info\"}"
    },
    {
      "expect": {
        "ok": false,
        "error": "bad_frame",
        "message": "<any>"
      }
    },
    {
      "send": "@PR 00000000 {\"seq\":2,\"cmd\":\"delete\",\"kind\":\"animation\",\"id\":\"dot\"}"
    },
    {
      "expect": {
        "ok": false,
        "error": "bad_frame",
        "message": "<any>"
      }
    },
    {
      "expect_files": {
        "animations/dot.json": "{\"format\":\"pixelart/1\",\"name\":\"Dot\",\"canvas\":{\"width\":16,\"height\":16},\"sprites\":{\"dot\":{\"points\":[[7,7,\"#ff0000\"]]}},\"timeline\":[{\"show\":[\"dot\"]}]}"
      }
    }
  ]
}
