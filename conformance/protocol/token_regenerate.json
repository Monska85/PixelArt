{
  "description": "token_regenerate replies with a token over USB and refuses a field",
  "steps": [
    {
      "send": "@PR c15d7ec9 {\"seq\":1,\"cmd\":\"token_regenerate\"}"
    },
    {
      "expect": {
        "seq": 1,
        "ok": true,
        "token": "<any>"
      }
    },
    {
      "send": "@PR 0b018c1a {\"seq\":2,\"cmd\":\"token_regenerate\",\"extra\":1}"
    },
    {
      "expect": {
        "seq": 2,
        "ok": false,
        "error": "bad_request",
        "message": "<any>"
