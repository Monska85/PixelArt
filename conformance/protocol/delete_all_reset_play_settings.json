{
  "description": "delete_all with settings true puts play, playlists, time_sync_hours and ntp_server back to their defaults",
  "files": {
    "animations/dot.json": "{\"format\":\"pixelart/1\",\"name\":\"Dot\",\"canvas\":{\"width\":16,\"height\":16},\"sprites\":{\"dot\":{\"points\":[[7,7,\"#ff0000\"]]}},\"timeline\":[{\"show\":[\"dot\"]}]}",
    "playlists/halloween.json": "{\"format\":\"pixelart-playlist/1\",\"canvas\":{\"width\":16,\"height\":16},\"items\":[{\"animation\":\"dot\"}]}",
    "playlists/christmas.json": "{\"format\":\"pixelart-playlist/1\",\"canvas\":{\"width\":16,\"height\":16},\"items\":[{\"animation\":\"dot\"}]}"
  },
  "settings": {
    "playlist": "halloween",
    "play": "playlists",
    "playlists": [
      "halloween",
      "christmas"
    ],
    "time_sync_hours": 24,
    "ntp_server": "time.example.org"
  },
  "steps": [
    {
      "send": "@PR 595a097c {\"seq\":1,\"cmd\":\"delete_all\",\"settings\":true}"
    },
    {
      "expect": {
        "seq": 1,
        "ok": true,
        "play": 0,
        "schedules": 0,
        "playlists": 2,
        "animations": 1,
        "settings": {
          "brightness": 100,
          "playlist": "default",
          "play": "auto",
          "playlists": [
            "default"
          ],
          "schedule": "default",
          "wifi_power": "auto",
          "update_mode": "automatic",
          "update_firmware": true,
          "update_animations": true,
          "check_hours": 6,
          "install_start": 0,
          "install_end": 0,
          "timezone": "UTC0",
          "time_sync_hours": 6,
          "ntp_server": "pool.ntp.org",
          "animation_source": "https://monska85.github.io/PixelArt/manifest.json",
          "network_login": false,
          "token": "<any>"
        }
      }
    },
    {
      "send": "@PR 57b65ab0 {\"seq\":2,\"cmd\":\"settings_get\"}"
    },
    {
      "expect": {
        "seq": 2,
        "ok": true,
        "settings": {
          "brightness": 100,
          "playlist": "default",
          "play": "auto",
          "playlists": [
            "default"
          ],
          "schedule": "default",
          "wifi_power": "auto",
          "update_mode": "automatic",
          "update_firmware": true,
          "update_animations": true,
          "check_hours": 6,
          "install_start": 0,
          "install_end": 0,
          "timezone": "UTC0",
          "time_sync_hours": 6,
          "ntp_server": "pool.ntp.org",
          "animation_source": "https://monska85.github.io/PixelArt/manifest.json",
          "network_login": false,
          "token": "<any>"
        }
      }
    }
  ]
}
