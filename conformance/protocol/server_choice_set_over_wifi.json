{
  "description": "server_choice_set works over WiFi like over USB",
  "transport": "wifi",
  "steps": [
    {
      "send": "@PR 8f492443 {\"seq\":1,\"cmd\":\"server_choice_set\",\"choice\":{\"playlists\":[\"christmas\"]}}"
    },
    {
      "expect": {
        "seq": 1,
        "ok": true,
        "choice": {
          "playlists": [
            "christmas"
          ]
        }
      }
    },
    {
      "send": "@PR bbb140d1 {\"seq\":2,\"cmd\":\"server_choice_set\",\"choice\":null}"
    },
    {
      "expect": {
        "seq": 2,
        "ok": true,
        "choice": null
      }
    }
  ]
}
