{
  "description": "A request with one bad value among valid ones changes none of them",
  "steps": [
    {
      "send": "@PR b06b2c5d {\"seq\":1,\"cmd\":\"settings_set\",\"brightness\":7,\"wifi_power\":\"21\"}"
    },
    {
      "expect": {
        "seq": 1,
        "ok": false,
        "error": "bad_request",
        "message": "<any>"
      }
    },
    {
      "send": "@PR cef6e0e1 {\"seq\":2,\"cmd\":\"settings_set\",\"update_mode\":\"notify\",\"check_hours\":0}"
    },
    {
      "expect": {
        "seq": 2,
        "ok": false,
        "error": "bad_request",
        "message": "<any>"
      }
    },
    {
      "send": "@PR 2511df6f {\"seq\":3,\"cmd\":\"settings_set\",\"timezone\":\"CET-1\",\"animation_source\":\"ftp://x\"}"
    },
    {
      "expect": {
        "seq": 3,
        "ok": false,
        "error": "bad_request",
        "message": "<any>"
      }
    },
    {
      "send": "@PR ba7c28ca {\"seq\":4,\"cmd\":\"settings_get\"}"
    },
    {
      "expect": {
        "seq": 4,
        "ok": true,
        "settings": {
          "brightness": 100,
          "playlist": "default",
          "wifi_power": "auto",
          "update_mode": "automatic",
          "update_firmware": true,
          "update_animations": true,
          "check_hours": 6,
          "install_start": 0,
          "install_end": 0,
          "timezone": "UTC0",
          "animation_source": "https://monska85.github.io/PixelArt/manifest.json",
          "network_login": false,
          "token": "<any>"
        }
      }
    }
  ]
}
