{
  "description": "A firmware on its trial boot answers update_install for firmware with busy, whatever the check found, until it shows its first frame",
  "firmware_version": "1.2.0",
  "update_source": {
    "files": {
      "manifest.json": {
        "json": {
          "format": "pixelart-manifest/1",
          "version": "1.3.0",
          "released": "2026-11-02",
          "firmware": [
            {
              "board": "simulator",
              "chip": "ESP32-C3",
              "part": "app",
              "offset": 65536,
              "file": "firmware/simulator/app-1.3.0.bin",
              "size": 28,
              "sha256": "23ba1f1584f0255331e91c12e5cf91a0af8ea2cce2b48852e8f79d174a307c1e"
            }
          ],
          "animations": [],
          "playlists": []
        }
      },
      "firmware/simulator/app-1.3.0.bin": "pixelart-sim-firmware 1.3.0\n"
    }
  },
  "settings": {
    "update_mode": "notify"
  },
  "steps": [
    {
      "send": "@PR 935d27e0 {\"seq\":1,\"cmd\":\"update_check\"}"
    },
    {
      "expect": {
        "seq": 1,
        "ok": true
      }
    },
    {
      "run_update": true
    },
    {
      "send": "@PR 643bdae2 {\"seq\":2,\"cmd\":\"update_install\",\"target\":\"firmware\"}"
    },
    {
      "expect": {
        "seq": 2,
        "ok": true
      }
    },
    {
      "run_update": true
    },
    {
      "reboot": true
    },
    {
      "send": "@PR 1bad27c8 {\"seq\":4,\"cmd\":\"update_install\",\"target\":\"firmware\"}"
    },
    {
      "expect": {
        "seq": 4,
        "ok": false,
        "error": "busy",
        "message": "<any>"
      }
    },
    {
      "send": "@PR bdc6b201 {\"seq\":5,\"cmd\":\"update_install\",\"target\":\"firmware\",\"force\":true}"
    },
    {
      "expect": {
        "seq": 5,
        "ok": false,
        "error": "busy",
        "message": "<any>"
      }
    },
    {
      "first_frame": true
    },
    {
      "send": "@PR 87f07111 {\"seq\":6,\"cmd\":\"update_install\",\"target\":\"firmware\"}"
    },
    {
      "expect": {
        "seq": 6,
        "ok": false,
        "error": "nothing_to_install",
        "message": "<any>"
      }
    }
  ]
}
