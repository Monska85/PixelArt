{
  "description": "a playlist that disagrees with play or playlists is bad_request, and nothing changes",
  "files": {
    "animations/dot.json": "{\"format\":\"pixelart/1\",\"name\":\"Dot\",\"canvas\":{\"width\":16,\"height\":16},\"sprites\":{\"dot\":{\"points\":[[7,7,\"#ff0000\"]]}},\"timeline\":[{\"show\":[\"dot\"]}]}",
    "playlists/halloween.json": "{\"format\":\"pixelart-playlist/1\",\"canvas\":{\"width\":16,\"height\":16},\"items\":[{\"animation\":\"dot\"}]}",
    "playlists/christmas.json": "{\"format\":\"pixelart-playlist/1\",\"canvas\":{\"width\":16,\"height\":16},\"items\":[{\"animation\":\"dot\"}]}",
    "playlists/default.json": "{\"format\":\"pixelart-playlist/1\",\"canvas\":{\"width\":16,\"height\":16},\"items\":[{\"animation\":\"dot\"}]}"
  },
  "steps": [
    {
      "send": "@PR 5847daad {\"seq\":1,\"cmd\":\"settings_set\",\"play\":\"auto\",\"playlist\":\"christmas\"}"
    },
    {
      "expect": {
        "seq": 1,
        "ok": false,
        "error": "bad_request",
        "message": "<any>"
      }
    },
    {
      "send": "@PR a8c6d0a1 {\"seq\":2,\"cmd\":\"settings_set\",\"play\":\"playlists\",\"playlists\":[\"halloween\"],\"playlist\":\"christmas\"}"
    },
    {
      "expect": {
        "seq": 2,
        "ok": false,
        "error": "bad_request",
        "message": "<any>"
      }
    },
    {
      "send": "@PR f5666c83 {\"seq\":3,\"cmd\":\"settings_set\",\"playlists\":[\"halloween\"],\"playlist\":\"halloween\"}"
    },
    {
      "expect": {
        "seq": 3,
        "ok": false,
        "error": "bad_request",
        "message": "<any>"
      }
    },
    {
      "send": "@PR e0054edd {\"seq\":4,\"cmd\":\"settings_set\",\"play\":\"auto\",\"playlists\":[\"christmas\"],\"playlist\":\"christmas\"}"
    },
    {
      "expect": {
        "seq": 4,
        "ok": false,
        "error": "bad_request",
        "message": "<any>"
      }
    },
    {
      "send": "@PR 210fc21e {\"seq\":5,\"cmd\":\"settings_get\"}"
    },
    {
      "expect": {
        "seq": 5,
        "ok": true,
        "settings": {
          "brightness": 100,
          "playlist": "default",
          "play": "auto",
          "playlists": [
            "default"
          ],
          "schedule": "default",
          "wifi_power": "auto",
          "update_mode": "automatic",
          "update_firmware": true,
          "update_animations": true,
          "check_hours": 6,
          "install_start": 0,
          "install_end": 0,
          "timezone": "UTC0",
          "time_sync_hours": 6,
          "ntp_server": "pool.ntp.org",
          "animation_source": "https://monska85.github.io/PixelArt/manifest.json",
          "network_login": false,
          "token": "<any>"
        }
      }
    }
  ]
}
