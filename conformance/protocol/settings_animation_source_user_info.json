{
  "description": "animation_source with user information (user:pass@host) is bad_request and changes nothing",
  "steps": [
    {
      "send": "@PR 9230fa03 {\"seq\":1,\"cmd\":\"settings_set\",\"animation_source\":\"https://user@example.com/m.json\"}"
    },
    {
      "expect": {
        "seq": 1,
        "ok": false,
        "error": "bad_request",
        "message": "<any>"
      }
    },
    {
      "send": "@PR 8ac049ac {\"seq\":2,\"cmd\":\"settings_set\",\"animation_source\":\"https://user:pass@example.com/m.json\"}"
    },
    {
      "expect": {
        "seq": 2,
        "ok": false,
        "error": "bad_request",
        "message": "<any>"
      }
    },
    {
      "send": "@PR bde5697d {\"seq\":3,\"cmd\":\"settings_set\",\"animation_source\":\"http://example.com@evil.example/m.json\"}"
    },
    {
      "expect": {
        "seq": 3,
        "ok": false,
        "error": "bad_request",
        "message": "<any>"
      }
    },
    {
      "send": "@PR ba7c28ca {\"seq\":4,\"cmd\":\"settings_get\"}"
    },
    {
      "expect": {
        "seq": 4,
        "ok": true,
        "settings": {
          "brightness": 100,
          "playlist": "default",
          "play": "auto",
          "playlists": [
            "default"
          ],
          "schedule": "default",
          "wifi_power": "auto",
          "update_mode": "automatic",
          "update_firmware": true,
          "update_animations": true,
          "check_hours": 6,
          "install_start": 0,
          "install_end": 0,
          "timezone": "UTC0",
          "time_sync_hours": 6,
          "ntp_server": "pool.ntp.org",
          "animation_source": "https://monska85.github.io/PixelArt/manifest.json",
          "network_login": false,
          "token": "<any>"
        }
      }
    }
  ]
}
