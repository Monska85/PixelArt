          "check_hours": 6,
          "install_start": 0,
          "install_end": 0,
          "timezone": "UTC0",
          "animation_source": "https://monska85.github.io/PixelArt/manifest.json",
          "network_login": false,
          "token": "<any>"
        }
      }
    }
  ]
}
