{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Monska85/PixelArt/schema/playlist-1.schema.json",
  "title": "PixelArt playlist, format pixelart-playlist/1",
  "description": "Which animations the board plays, in which order. See docs/format/playlist-v1.md.",
  "type": "object",
  "required": ["format", "canvas", "items"],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "pixelart-playlist/1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "canvas": {
      "description": "Size of the matrix the playlist is made for. Version 1 supports only 16x16.",
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width": {
          "const": 16
        },
        "height": {
          "const": 16
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["animation"],
        "additionalProperties": false,
        "properties": {
          "animation": {
            "description": "Animation ID: its file name without extension.",
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
          },
          "repeat": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 1
          },
          "enabled": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  }
}
