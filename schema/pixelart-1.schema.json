{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Monska85/PixelArt/schema/pixelart-1.schema.json",
  "title": "PixelArt animation, format pixelart/1",
  "description": "One animation for the LED matrix. See docs/format/pixelart-v1.md for the meaning of each field and for the rules this schema cannot express (references between sprites, nesting depth, total counts).",
  "type": "object",
  "required": ["format", "name", "canvas", "sprites", "timeline"],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "pixelart/1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "author": {
      "type": "string",
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 512
    },
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width": {
          "const": 16
        },
        "height": {
          "const": 16
        }
      }
    },
    "frame_ms": {
      "$ref": "#/$defs/duration",
      "default": 500
    },
    "brightness": {
      "description": "Percentage of the board brightness the animation plays at. It can only lower the board setting.",
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 100
    },
    "background": {
      "$ref": "#/$defs/color"
    },
    "palette": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/hex"
      }
    },
    "sprites": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sprite"
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "name": {
      "description": "Name of a palette color or a sprite.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "hex": {
      "description": "Color as #rrggbb. Must be quoted in YAML.",
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "color": {
      "description": "A palette name or a #rrggbb value.",
      "anyOf": [
        {
          "$ref": "#/$defs/name"
        },
        {
          "$ref": "#/$defs/hex"
        }
      ]
    },
    "coordinate": {
      "type": "integer",
      "minimum": -128,
      "maximum": 127
    },
    "position": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/coordinate"
        },
        {
          "$ref": "#/$defs/coordinate"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "duration": {
      "type": "integer",
      "minimum": 20,
      "maximum": 60000
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "angle": {
      "enum": [-270, -180, -90, 0, 90, 180, 270]
    },
    "point": {
      "description": "[x, y, color]",
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/coordinate"
        },
        {
          "$ref": "#/$defs/coordinate"
        },
        {
          "$ref": "#/$defs/color"
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "points": {
      "oneOf": [
        {
          "description": "One [x, y, color] entry per pixel.",
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        {
          "description": "Pixels grouped by color: color -> list of [x, y].",
          "type": "object",
          "minProperties": 1,
          "maxProperties": 256,
          "propertyNames": {
            "$ref": "#/$defs/color"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "$ref": "#/$defs/position"
            }
          }
        }
      ]
    },
    "part": {
      "oneOf": [
        {
          "$ref": "#/$defs/name"
        },
        {
          "type": "object",
          "required": ["sprite"],
          "additionalProperties": false,
          "properties": {
            "sprite": {
              "$ref": "#/$defs/name"
            },
            "at": {
              "$ref": "#/$defs/position"
            }
          }
        }
      ]
    },
    "sprite": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "at": {
          "$ref": "#/$defs/position"
        },
        "pivot": {
          "$ref": "#/$defs/position"
        },
        "points": {
          "$ref": "#/$defs/points"
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/part"
          }
        }
      },
      "oneOf": [
        {
          "required": ["points"]
        },
        {
          "required": ["parts"]
        }
      ]
    },
    "spriteRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/name"
        },
        {
          "type": "object",
          "required": ["sprite"],
          "additionalProperties": false,
          "properties": {
            "sprite": {
              "$ref": "#/$defs/name"
            },
            "at": {
              "$ref": "#/$defs/position"
            },
            "move": {
              "$ref": "#/$defs/position"
            },
            "wrap": {
              "type": "boolean",
              "default": false
            },
            "rotate": {
              "$ref": "#/$defs/angle"
            },
            "spin": {
              "$ref": "#/$defs/angle"
            },
            "flip": {
              "enum": ["x", "y", "xy"]
            },
            "pivot": {
              "$ref": "#/$defs/position"
            }
          }
        }
      ]
    },
    "frame": {
      "type": "object",
      "required": ["show"],
      "additionalProperties": false,
      "properties": {
        "show": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/spriteRef"
          },
          "description": "Sprites drawn bottom to top. At most 4,096 pixels may be drawn in one frame, counting every part of composite sprites; the engine checks this, the schema cannot."
        },
        "ms": {
          "$ref": "#/$defs/duration"
        },
        "repeat": {
          "$ref": "#/$defs/count"
        },
        "recolor": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 256,
          "propertyNames": {
            "$ref": "#/$defs/color"
          },
          "additionalProperties": {
            "$ref": "#/$defs/color"
          }
        }
      }
    },
    "loop": {
      "type": "object",
      "required": ["loop", "steps"],
      "additionalProperties": false,
      "properties": {
        "loop": {
          "$ref": "#/$defs/count"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "item": {
      "oneOf": [
        {
          "$ref": "#/$defs/frame"
        },
        {
          "$ref": "#/$defs/loop"
        }
      ]
    }
  }
}
