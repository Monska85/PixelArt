{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Monska85/PixelArt/schema/manifest-1.schema.json",
  "title": "PixelArt release manifest, format pixelart-manifest/1",
  "description": "Lists the files of one release with their sizes and SHA-256 checksums. See docs/format/manifest-v1.md.",
  "type": "object",
  "required": ["format", "version", "released", "animations", "playlists"],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "pixelart-manifest/1"
    },
    "version": {
      "description": "The version of the release the manifest comes from: the firmware version, or the content version in a content release. Local dry runs carry a pre-release and build part.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
      "maxLength": 64
    },
    "released": {
      "description": "Release date, YYYY-MM-DD.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "source": {
      "description": "Optional. Where the source code of this release is: the tree of its tag or commit. Boards and the web app do not read it.",
      "type": "string",
      "pattern": "^https://[^\\s]+$",
      "maxLength": 200
    },
    "content_version": {
      "description": "Optional. The version of the content release whose animations and playlists the manifest lists: its tag without the leading content-v. Absent when they do not come from a content release.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
      "maxLength": 64
    },
    "firmware": {
      "description": "Optional. Every firmware file, for every board. Absent in a content release.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["board", "chip", "part", "offset", "file", "size", "sha256"],
        "additionalProperties": false,
        "properties": {
          "board": {
            "enum": ["esp32c3", "esp32", "esp32s3"]
          },
          "chip": {
            "description": "The ESP Web Tools chip family.",
            "enum": ["ESP32-C3", "ESP32", "ESP32-S3"]
          },
          "part": {
            "enum": ["bootloader", "partitions", "boot_app0", "app", "filesystem", "factory"]
          },
          "offset": {
            "description": "Flash address the part is written to, in bytes.",
            "type": "integer",
            "minimum": 0
          },
          "file": {
            "description": "Path relative to the manifest, firmware/<board>/<part>-<version>.bin.",
            "type": "string",
            "pattern": "^firmware/[a-z0-9]+/[a-z0-9_]+-[0-9A-Za-z.+-]+\\.bin$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "animations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "version", "file", "size", "sha256"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "file": {
            "type": "string",
            "pattern": "^animations/[a-z0-9][a-z0-9_-]{0,31}\\.json$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "playlists": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file", "size", "sha256"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "file": {
            "type": "string",
            "pattern": "^playlists/[a-z0-9][a-z0-9_-]{0,31}\\.json$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "description": "File ID: its file name without extension.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
